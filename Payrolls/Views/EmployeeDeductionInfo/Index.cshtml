
<button type="button" class="btn btn-success mb-4" data-bs-toggle="modal" data-bs-target="#exampleModal">
    Add Data
</button>

<!-- Search Filters -->
<div class="card">
    <div class="card-body">
        <div class="row">
            <!-- Employee Filter selecter -->
            <div class="col-md-5">
                <label class="form-label">EmployeeId</label>
                <select class="form-control empid-search"></select>
            </div>

            <!-- Deduction Filter optionnal-->
            <div class="col-md-5">
                <label class="form-label">DeductionHeadId</label>
                <select class="form-control dedid-search"></select>
            </div>

            <!-- Search Button -->
            <div class="col-md-2">
                <button class="btn btn-success mt-4 find" type="button" style="width:100px;">
                    Search
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Display Data Table -->
<div class="row mt-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body" style="overflow:auto;">
                <table class="table table-hover tblSetup">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>EmployeeId</th>
                            <th>DeductHeadId</th>
                            <th>DeductYear</th>
                            <th>DeductMonth</th>
                            <th>Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="main-data"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal For Insert/Update -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <form>

                    <!-- Employee Select in Modal -->
                    <div class="mb-3">
                        <label class="form-label">Employee ID</label>
                        <select class="form-control empid-modal"></select>
                    </div>

                    <!-- Deduction Select in Modal -->
                    <div class="mb-3">
                        <label class="form-label">Deduction Head ID</label>
                        <select class="form-control dedid-modal"></select>
                    </div>


                    <!-- Month option-->
                    <div class="mb-3">
                        <label class="form-label">Deduction month</label>
                        <select class="form-control mon">
                            <option value="0">Choose</option>
                            <option value="1">Jan</option>
                            <option value="2">Feb</option>
                            <option value="3">March</option>
                            <option value="4">April</option>
                            <option value="5">May</option>
                            <option value="6">June</option>
                            <option value="7">July</option>
                            <option value="8">August</option>
                            <option value="9">September</option>
                            <option value="10">October</option>
                            <option value="11">November</option>
                            <option value="12">December</option>
                        </select>
                    </div>
                    <!-- Year -->
                    <div class="mb-3">
                        <label class="form-label">Deduction year</label>
                        <input type="text" class="form-control yer">
                    </div>
                    <!-- Amount  -->
                    <div class="mb-3">
                        <label class="form-label">Deduction amount</label>
                        <input type="text" class="form-control amt">
                    </div>
                    <input type="hidden" id="hdn" class="form-control">
                </form>
            </div>
            <div class="modal-footer">
                <button class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                <button class="btn btn-primary addition">Save changes</button>
            </div>
        </div>
    </div>
</div>

<!-- Scripts Section -->
@section Scripts {
    <script>
        $(document).ready(function () {
            loaddata();
            getdeductionhead();
            getemployeeid();
        });

        // ----------------Populate Employee Dropdowns------------------
        function getemployeeid() {
            $.ajax({
                method: 'get',
                url: '@Url.Action("GetActiveEmployees", "Employee")',
                success: function (respo) {
                    let htmls = '<option value="0">Choose</option>';
                    $.each(respo, function (i, x) {
                        htmls += `<option value="${x.employeeId}">${x.fullname}</option>`;
                    });
                    $('.empid-modal, .empid-search').html(htmls);
                }
            });
        }
        // ----------------Populate Employee Dropdowns-----------------



        // ------------start Populate Deduction Head Dropdowns--------------
        function getdeductionhead() {
            $.ajax({
                method: 'get',
                url: '@Url.Action("GetActiveDeduction", "Deduction")',
                success: function (respo) {
                    let htmls = '<option value="0">Choose</option>';
                    $.each(respo, function (i, x) {
                        htmls += `<option value="${x.deductionHeadId}">${x.deductionHeadName}</option>`;
                    });
                    $('.dedid-modal, .dedid-search').html(htmls);
                }
            });
        }
         // ----------------end Populate Deduction Head Dropdowns------------------


        // -------------------Load data into the table with filters------------------
        function loaddata() {
            var empid = $('.empid-search').val();
            var HeadId = $('.dedid-search').val();

            $.ajax({
                method: 'get',
                url: '@Url.Action("loaddata", "employeedeductioninfo")?employeeid=' + empid + '&deductionheadid=' + HeadId,
                success: function (respo) {
                    var htmls = '';
                    $.each(respo, function (index, item) {
                        htmls += `<tr>
                            <td>${index + 1}</td>
                            <td>${item.employeeFullname}</td>
                            <td>${item.deductionHeadName}</td>
                            <td>${item.deductionYear}</td>
                            <td>${item.deductionMonth}</td>
                            <td>${item.amount}</td>
                            <td>
                                <button class="btn btn-sm btn-success me-2 change" data-key="${item.employeeDeductionId}">Edit</button>
                                <button class="btn btn-sm btn-danger remove" data-key="${item.employeeDeductionId}">Delete</button>
                            </td>
                        </tr>`;
                    });
                    $('.main-data').html(htmls);
                }
            });
        }

         // ------------------endLoad data into the table with filters------------------


        // ---------------start Edit button logic---------------
        $(document).on('click', '.change', function () {
            var ID = $(this).data('key');
            $('#hdn').val(ID);

            $.ajax({
                method: 'get',
                url: '@Url.Action("edit_req", "employeedeductioninfo")?EmployeeDeductionId=' + ID,
                success: function (respo) {
                    $('.empid-modal').val(respo.data.employeeID);
                    $('.dedid-modal').val(respo.data.deductionHeadId);
                    $('.mon').val(respo.data.deductionMonth);
                    $('.yer').val(respo.data.deductionYear);
                    $('.amt').val(respo.data.amount);
                    $('#hdn').val(respo.data.employeeDeductionId);

                    var myModal = new bootstrap.Modal(document.getElementById('exampleModal'));
                    myModal.show();
                }
            });
        });
         // ---------------end Edit button logic---------------


        // -------------------Save (Add or Update)----------------
                $(document).on('click', '.addition', function () {
            // var data = {
            //     employeeid: $('.empid-modal').val(),
            //     deductionid: $('.dedid-modal').val(),
            //     month: $('.mon').val(),
            //     year: $('.yer').val(),
            //     amount: $('.amt').val(),
            //     mainid: $('#hdn').val()
            // };

            // $.ajax({
            //     method: 'POST', Changed from GET
            //     url: '@Url.Action("Adddata", "employeedeductioninfo")',
            //     data: data,
            //     success: function (respo) {
            //         clear();
            //         loaddata();
            //         Swal.fire("Good job!", respo.Message || respo.message, "success");

            //         var myModal = bootstrap.Modal.getInstance(document.getElementById('exampleModal'));
            //         if (myModal) myModal.hide();
            //     }
            // });

            alert("heloo thisbis saved button");
        });

         // -------------------end Save (Add or Update)----------------



        // -------------------start Delete Logic-------------------
        $(document).on('click', '.remove', function () {
            var ID = $(this).data('key');

            Swal.fire({
                title: "Are you sure?",
                text: "You won't be able to revert this!",
                icon: "warning",
                showCancelButton: true,
                confirmButtonColor: "#3085d6",
                cancelButtonColor: "#d33",
                confirmButtonText: "Yes, delete it!"
            }).then((result) => {
                if (result.isConfirmed) {
                    $.ajax({
                        method: 'get',
                        url: '@Url.Action("deletedata", "employeedeductioninfo")?id=' + ID,
                        success: function (respo) {
                            loaddata();
                            Swal.fire("Deleted!", "Data has been deleted.", "success");
                        }
                    });
                }
            });
        });

        // -------------------end Delete Logic-------------------


        // ---------------start Clear Form-------------------
        function clear() {
            $('.empid-modal').val('');
            $('.dedid-modal').val('');
            $('.mon').val('');
            $('.yer').val('');
            $('.amt').val('');
            $('#hdn').val('');
        }
         // ---------------end Clear Form-------------------


        // --------------Search Click---------------------
        $(document).on('click', '.find', function () {
            loaddata();
        });
    </script>
}
