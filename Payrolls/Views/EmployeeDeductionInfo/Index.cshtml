@{
    ViewData["Title"] = "Employee Deductions";
}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" integrity="sha512-Evv84Mr4kqVGRNSgIGL/F/aIDqQb7xQ2vcrdIwxfjThSH8CSR7PBEakCr51Ck+w+/U6swU2Im1vVX0SVk9ABhg==" crossorigin="anonymous" referrerpolicy="no-referrer" />
<div class="row mb-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <!-- Employee Filter -->
                    <div class="col-md-4">
                        <label class="form-label">Employee</label>
                        <input type="text" class="form-control empid-search" placeholder="Type employee name">

                        @* <select class="form-control empid-search"></select> *@
                    </div>

                    <!-- Deduction Filter -->
                    <div class="col-md-4">
                        <label class="form-label">Deduction Head</label>
                        <input type="text" class="form-control dedid-search" placeholder="Type deduction name">
                        @* <select class="form-control dedid-search"></select> *@
                    </div>

                    <!-- Search & Add -->
                    <div class="col-md-4 mt-4">
                        <button class="btn btn-success find" type="button" style="width:100px;"><i class="fa-solid fa-magnifying-glass"></i>Search</button>
                        <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#exampleModal">
                            <i class="fa-solid fa-address-book"></i> Add Data
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Data Table -->
<div class="row mt-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body" style="overflow:auto;">
                <table class="table table-hover tblSetup">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Employee</th>
                            <th>Deduction Head</th>
                            <th>Year</th>
                            <th>Month</th>
                            <th>Amount</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="main-data"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="exampleModal" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Employee Deduction Form</h5>
                <!-- Correct close button for Bootstrap 5 -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">Employee</label>
                        <select class="form-control empid-modal"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Deduction Head</label>
                        <select class="form-control dedid-modal"></select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Month</label>
                        <select class="form-control mon">
                            <option value="0">Choose</option>
                            @for (int i = 1; i <= 12; i++)
                            {
                                <option value="@i">@System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(i)</option>
                            }
                        </select>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Year</label>
                        <input type="text" class="form-control yer" />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Amount</label>
                        <input type="text" class="form-control amt" />
                    </div>

                    <input type="hidden" id="hdn" />
                </form>
            </div>

            <div class="modal-footer">
                <!-- Correct data-bs-dismiss for Bootstrap 5 -->
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">Close</button>
                <button type="button" class="btn btn-primary addition">Save </button>
            </div>

        </div>
    </div>
</div>



@section Scripts {
<script>
$(document).ready(function(){
    loadEmployeeDropdowns();
    loadDeductionDropdowns();
    loaddata();
});

// Populate Employee dropdowns
function loadEmployeeDropdowns(){
    $.ajax({
        url:'@Url.Action("GetActiveEmployees","Employee")',
        type:'GET',
        success:function(res){
            let html = '<option value="0">Choose</option>';
            $.each(res,function(i,x){
                html += `<option value="${x.employeeId}">${x.fullname}</option>`;
            });
            $('.empid-modal,.empid-search').html(html);
        }
    });
}

// Populate Deduction dropdowns from your Deduction model
function loadDeductionDropdowns(){
    $.ajax({
        url:'@Url.Action("GetActiveDeduction","Deduction")', // <-- Deduction controller
        type:'GET',
        success:function(res){
            let html = '<option value="0">Choose</option>';
            $.each(res,function(i,x){
                html += `<option value="${x.deductionHeadId}">${x.deductionHeadName}</option>`;
            });
            $('.dedid-modal,.dedid-search').html(html);
        }
    });
}

// Load table
function loaddata(){
    var empid = $('.empid-search').val();
    var dedid = $('.dedid-search').val();

    $.ajax({
        url:'@Url.Action("loaddata","EmployeeDeductionInfo")',
        type:'GET',
        data:{employeeid:empid,deductionheadid:dedid},
        success:function(res){
            let html='';
            $.each(res,function(i,item){
                html += `<tr>
                    <td>${i+1}</td>
                    <td>${item.employeeFullname}</td>
                    <td>${item.deductionHeadName}</td>
                    <td>${item.deductionYear}</td>
                    <td>${item.deductionMonth}</td>
                    <td>${item.amount}</td>
                    <td>
                                <button class="btn btn-sm btn-success me-2 change" data-key="${item.employeeDeductionId}"> <i class="fa-solid fa-pen-to-square"></i> Edit</button>
                                <button class="btn btn-sm btn-danger remove" data-key="${item.employeeDeductionId}"> <i class="fa-solid fa-trash"></i> Delete</button>
                    </td>
                </tr>`;
            });
            $('.main-data').html(html);
             new DataTable('.tblSetup');
        }
    });
}

// Edit
$(document).on('click','.change',function(){
    var id=$(this).data('key');
    $.ajax({
        url:'@Url.Action("edit_req","EmployeeDeductionInfo")',
        type:'GET',
        data:{employeedeductionid:id},
        success:function(res){
            $('.empid-modal').val(res.data.employeeID);
            $('.dedid-modal').val(res.data.deductionHeadId);
            $('.mon').val(res.data.deductionMonth);
            $('.yer').val(res.data.deductionYear);
            $('.amt').val(res.data.amount);
            $('#hdn').val(res.data.employeeDeductionId);
            var modal = new bootstrap.Modal(document.getElementById('exampleModal'));
            modal.show();
        }
    });
});

// Add / Update
$(document).on('click','.addition',function(){
    var data = {
        mainid: $('#hdn').val(),
        employeeid: $('.empid-modal').val(),
        deductionid: $('.dedid-modal').val(),
        month: $('.mon').val(),
        year: $('.yer').val(),
        amount: $('.amt').val()
    };
           $.ajax({
            url:'@Url.Action("Adddata", "EmployeeDeductionInfo")',
            type:'POST',
            data: data, // sends as form data
            success:function(res){
                Swal.fire("Good job!", res.Message, "success");
                clearForm();
                loaddata();
               

            }
        });
});

// Delete
$(document).on('click','.remove',function(){
    var id=$(this).data('key');
    Swal.fire({
        title:"Are you sure?",
        text:"You won't be able to revert this!",
        icon:"warning",
        showCancelButton:true,
        confirmButtonText:"Yes, delete it!"
    }).then((result)=>{
        if(result.isConfirmed){
                   $.ajax({
            url:'@Url.Action("deletedata", "EmployeeDeductionInfo")',
            type:'POST', // use POST here
            data:{id:id},
            success:function(res){
                Swal.fire("Deleted!","Data deleted","success");
                loaddata();
            }
        });
        }
    });
});

// Clear Modal
function clearForm(){
    $('.empid-modal').val('0');
    $('.dedid-modal').val('0');
    $('.mon').val('0');
    $('.yer').val('');
    $('.amt').val('');
    $('#hdn').val('');
}

// Search button
$(document).on('click','.find',function(){
    loaddata();
    // alert("this is search buttion");
});
</script>
}

<script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/js/all.min.js" integrity="sha512-n2J3E48bSyQ6D7hJb+7riC0EzoQ9DN6c3V1HL4iKZp2tH2k0V4V0Hh8Xd1MfIw2c7wX2rY+EhKEfL2RG1+0BJg==" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

