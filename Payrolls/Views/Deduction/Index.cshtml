<!-- Deduction Search & Add Button -->
<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label>Deduction Name</label>
                        <input type="text" class="form-control txtSearchName" />
                    </div>
                    <div class="col-md-3">
                        <label>Deduction Code</label>
                        <input type="text" class="form-control txtSearchCode" />
                    </div>
                    <div class="col-md-3 mt-4">
                        <button type="button" class="btn btn-primary btnSearch">
                            <i class="fa-solid fa-magnifying-glass"></i> Search
                        </button>

                        <!-- Bootstrap 5: data-bs-toggle, data-bs-target -->
                        <button type="button" class="btn btn-success btnCreate" data-bs-toggle="modal" data-bs-target="#mdlSetup">
                            <i class="fa-solid fa-address-book"></i> Add Deduction
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Deduction Modal -->
<div class="modal fade" id="mdlSetup" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">

            <div class="modal-header">
                <h5 class="modal-title" id="exampleModalLabel">Deduction Form</h5>
                <!-- Bootstrap 5 close button -->
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>

            <div class="modal-body">
                <div class="form-group">
                    <label>Deduction Name</label>
                    <input type="text" class="form-control txtDeductionHeadName" />
                </div>

                <div class="form-group mt-2">
                    <label>Deduction Code</label>
                    <input type="text" class="form-control txtDeductionHeadCode" />
                </div>

                <div class="form-group mt-2">
                    <label>Order Key</label>
                    <input type="number" class="form-control txtOrderKey" />
                </div>
            </div>

            <div class="modal-footer">
                <button type="button" class="btn btn-danger" data-bs-dismiss="modal">
                    <i class="fa-solid fa-xmark"></i> Cancel
                </button>

                <button type="button" class="btn btn-success btnSave">
                    <i class="fa-solid fa-floppy-disk"></i> Save
                </button>

                <input type="hidden" class="hdnId" value="0" />
            </div>

        </div>
    </div>
</div>

<!-- Deduction Table -->
<div class="row mt-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body" style="overflow:auto;">
                <table class="table table-hover tblSetup">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Deduction ID</th>
                            <th>Deduction Name</th>
                            <th>Code</th>
                            <th>Order Key</th>
                            <th>Is Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="main-data"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Save Button Script for Bootstrap 5 -->
<script>
    document.addEventListener('DOMContentLoaded', function () {
        const modalEl = document.getElementById('mdlSetup');
        const modalInstance = new bootstrap.Modal(modalEl);

        document.querySelector('.btnSave').addEventListener('click', function () {
            // Simulate save (replace with your AJAX call)
            setTimeout(() => {
                toastr.success('Deduction saved successfully!');

                // Hide modal correctly
                modalInstance.hide();

                // Optional: reset inputs
                modalEl.querySelectorAll('input').forEach(input => input.value = '');
            }, 500);
        });
    });
</script>


@section Scripts {
    <script>
        $(document).ready(function () {
            loadData();
        });

        $(document).on('click', '.btnSearch', function () {
            loadData();
        });

        $(document).on('click', '#btnCancel', function () {
            if (confirm('Are you sure to cancel?')) clearForm();
        });

             $(document).on('click', '.btnCreate', function(){
                    clearForm();
                    $('#mdlSetup').modal('show');
                });

        $(document).on('click', '.btnSave', function () {
            var deductionHeadName = $('.txtDeductionHeadName').val().trim();
            var deductionHeadCode = $('.txtDeductionHeadCode').val().trim();
            var orderKey = $('.txtOrderKey').val().trim();

            if (deductionHeadName === "") {
                toastr.error("Please enter Deduction Name.");
                return;
            }

            if (deductionHeadCode === "") {
                toastr.error("Please enter Deduction Code.");
                return;
            }

            if (orderKey === "" || isNaN(orderKey)) {
                toastr.error("Please enter a valid Order Key (number).");
                return;
            }

            var data = {
                id: $('.hdnId').val(),
                deductionHeadName: deductionHeadName,
                deductionHeadCode: deductionHeadCode,
                orderKey: orderKey
            };

            $.ajax({
                method: 'GET',
                url: '@Url.Action("Create", "Deduction")',
                data: data,
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        clearForm();
                        loadData();
                    } else {
                        toastr.error(res.message);
                    }
                },
                  beforeSend: function () {
                       // $.blockUI();
                    },
                    complete: function () {
                        //$.unblockUI();
                    }
            });
        });


        function clearForm() {
            $('.txtDeductionHeadName').val('');
            $('.txtDeductionHeadCode').val('');
            $('.txtOrderKey').val('');
            $('.hdnId').val('0');
        }

        function loadData() {
            var filters = {
                name: $('.txtSearchName').val(),
                code: $('.txtSearchCode').val()
            };

            $.ajax({
                method: 'GET',
                url: '@Url.Action("GetActiveDeductionHeads", "Deduction")',
                data: filters,
                success: function (data) {
                    var html = '';
                    $.each(data, function (i, item) {
                        html += '<tr>';
                        html += '<td>' + (i + 1) + '</td>';
                        html += '<td>' + item.deductionHeadId + '</td>';
                        html += '<td>' + item.deductionHeadName + '</td>';
                        html += '<td>' + item.deductionHeadCode + '</td>';
                        html += '<td>' + item.orderKey + '</td>';
                        html += '<td>' + (item.isActive ? "true" : "false") + '</td>';
                        html += '<td>' +
                            '<button class="btn btn-secondary btn-sm btnEdit" data-id="' + item.deductionHeadId + '"><i class="fa-solid fa-pen-to-square"></i> Edit</button> ' +
                            '<button class="btn btn-danger btn-sm btnDelete" data-id="' + item.deductionHeadId + '"><i class="fa-solid fa-trash"></i> Delete</button>' +
                            '</td>';
                        html += '</tr>';
                    });

                    $('.main-data').html(html);

                  
                    new DataTable('.tblSetup');
                },  beforeSend: function () {
                       // $.blockUI();
                    },
                    complete: function () {
                        //$.unblockUI();
                    }
            });
        }

        $(document).on('click', '.btnEdit', function () {
            var id = $(this).data('id');
            $.ajax({
                method: 'GET',
                url: '@Url.Action("GetItemById", "Deduction")',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        $('.txtDeductionHeadName').val(res.data.deductionHeadName);
                        $('.txtDeductionHeadCode').val(res.data.deductionHeadCode);
                        $('.txtOrderKey').val(res.data.orderKey);
                        $('.hdnId').val(res.data.deductionHeadId);
                            $('#mdlSetup').modal('show');
                    } else {
                        toastr.error(res.message);
                    }
                },
                  beforeSend: function () {
                       // $.blockUI();
                    },
                    complete: function () {
                       // $.unblockUI();
                    }
            });
        });

        $(document).on('click', '.btnDelete', function () {
            if (!confirm("Are you sure you want to delete this item?")) return;

            var id = $(this).data('id');
            $.ajax({
                method: 'GET',
                url: '@Url.Action("DeleteDeductionHead", "Deduction")',
                data: { id: id },
                success: function (res) {
                    if (res.success) {
                        toastr.success(res.message);
                        loadData();
                    } else {
                        toastr.error(res.message);
                    }

                },
                  beforeSend: function () {
                        //$.blockUI();
                    },
                    complete: function () {
                        //$.unblockUI();
                    }
            });
        });
    </script>
}
