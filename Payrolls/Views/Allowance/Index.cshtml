<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label>Allowance  Name</label><br />
                        <input type="text" class="form-control txtSearchName" />
                    </div>
                    <div class="col-md-3">
                        <label>Allowance  Code</label><br />
                        <input type="text" class="form-control txtSearchCode" />
                    </div>
                    <div class="col-md-3">
                        <br />
                        <button type="button" class="btn btn-primary btnSearch"><i class="fa-solid fa-magnifying-glass"></i> Search</button>
                        <button type="button" class="btn btn-success btnCreate"><i class="fa-solid fa-address-book"></i> Add Allowance</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="mdlSetup" tabindex="-1" aria-labelledby="exampleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="exampleModalLabel">Allowance Form</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="col-md-12">
                    <label>Allowance  Name</label><br />
                    <input type="text" class="form-control txtAllowanceName" />
                </div>
                <div class="col-md-12 mt-3">
                    <label>Allowance  Code</label><br />
                    <input type="text" class="form-control txtAllowanceCode" />
                </div>
                <div class="col-md-12 mt-3">
                    <label>Order Key</label><br />
                    <input type="number" class="form-control txtOrderKey" />
                </div>

            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-success btnSave"><i class="fa-solid fa-floppy-disk"></i> Save</button>
                <button type="button" id="btnCancel" class="btn btn-danger"><i class="fa-solid fa-xmark"></i> Cancel</button>
                <input type="hidden" value="0" class="hdnId" />
            </div>
            
           
        </div>
    </div>
</div>



<!-- Allowance Table -->
<div class="row mt-2">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body" style="overflow:auto;">
                <table class="table table-hover tblSetup">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Allowance ID</th>
                            <th>Name</th>
                            <th>Code</th>
                            <th>Order Key</th>
                            <th>Is Active</th>
                            <th>Action</th>
                        </tr>
                    </thead>
                    <tbody class="main-data"></tbody>
                </table>
            </div>
        </div>
    </div>
</div>


@section Scripts {
    <script>
        $(document).ready(function () {
            loadData();
        });

        $(document).on('click', '.btnSearch', function () {
            loadData();
        });

        $(document).on('click', '#btnCancel', function () {
            if (confirm('Are you sure to cancel?')) clearForm();
        });

          $(document).on('click', '.btnCreate', function(){
                clearForm();
                $('#mdlSetup').modal('show');
            });

        $(document).on('click', '.btnSave', function () {
            var allowanceName = $('.txtAllowanceName').val().trim();
            var allowanceCode = $('.txtAllowanceCode').val().trim();
            var orderKey = $('.txtOrderKey').val().trim();

            if (allowanceName == "") {
                toastr.error("Please enter Allowance Name.");
                return;
            }

            if (allowanceCode == "") {
                toastr.error("Please enter Allowance  Code.");
                return;
            }

            if (orderKey == "" || isNaN(orderKey)) {
                toastr.error("Please enter a valid Order Key (number).");
                return;
            }

            var data = {
                id: $('.hdnId').val(),
                allowanceName: allowanceName,
                allowanceCode: allowanceCode,
                orderKey: orderKey
            };

            $.ajax({
                method: 'GET',
                url: '@Url.Action("Create", "Allowance")',
                data: data,
                success: function (resp) {
                    if (resp.success) {
                        toastr.success(resp.message);
                        clearForm();
                        loadData();
                    } else {
                        toastr.error(resp.message);
                    }
                },
                beforeSend: function () {
                    // $.blockUI();
                },
                complete: function () {
                    // $.unblockUI();
                }
            });
        });

        function clearForm() {
            $('.txtAllowanceName').val('');
            $('.txtAllowanceCode').val('');
            $('.txtOrderKey').val('');
            $('.hdnId').val('0');
        }

        function loadData() {
            var filters = {
                name: $('.txtSearchName').val(),
                code: $('.txtSearchCode').val()
            };

            $.ajax({
                method: 'GET',
                url: '@Url.Action("GetActiveAllowance", "Allowance")',
                data: filters,
                success: function (data) {
                    var html = '';
                    $.each(data, function (i, item) {
                        html += '<tr>';
                        html += '<td>' + (i + 1) + '</td>';
                        html += '<td>' + item.allowanceId + '</td>';
                        html += '<td>' + item.allowanceName + '</td>';
                        html += '<td>' + item.allowanceCode + '</td>';
                        html += '<td>' + item.orderKey + '</td>';
                        html += '<td>' + (item.isActive == true ? "true" : "false") + '</td>';
                        html += '<td>' +
                            '<button class="btn btn-secondary btn-sm btnEdit" data-id="' + item.allowanceId + '"><i class="fa-solid fa-pen-to-square"></i> Edit</button> ' +
                            '<button class="btn btn-danger btn-sm btnDelete" data-id="' + item.allowanceId + '"><i class="fa-solid fa-trash"></i> Delete</button>' +
                            '</td>';
                        html += '</tr>';
                    });

                   //-------- destroy datatable ---------

                    // if ($.fn.DataTable.isDataTable('.tblSetup')) {
                    //   $('.tblSetup').DataTable().clear().destroy();
                    //      }


                    $('.main-data').html(html);
                    new DataTable('.tblSetup');

                    // new DataTable('.tblSetup', {
                    //     layout: {
                    //         topStart: {
                    //             buttons: ['copy', 'csv', 'excel', 'pdf', 'print']
                    //         }
                    //     }
                    // });

                },
                beforeSend: function () {
                    // $.blockUI();
                },
                complete: function () {
                    // $.unblockUI();
                }
            });
        }

        // from here edit button code start -------
           $(document).on('click', '.btnEdit', function () {
            var id = $(this).data('id');
            $.ajax({
                method: 'GET',
                url: '@Url.Action("GetItemById", "Allowance")',
                data: { id: id },
                success: function (resp) {
                    if (resp.success == true) {
                        $('.txtAllowanceName').val(resp.data.allowanceName);
                        $('.txtAllowanceCode').val(resp.data.allowanceCode);
                        $('.txtOrderKey').val(resp.data.orderKey);
                        $('.hdnId').val(resp.data.allowanceId);
                        $('#mdlSetup').modal('show');
                    } else {
                        toastr.error(resp.message);
                    }
                },
                beforeSend: function () {
                    // $.blockUI();
                },
                complete: function () {
                    // $.unblockUI();
                }
            });
        });
        // edit GamepadButton code end here --------


        // ---------this is for deletebutton fire code start -------------

        $(document).on('click', '.btnDelete', function () {
            if (!confirm("Are you sure you want to delete this item?")) return;

            var id = $(this).data('id');
            $.ajax({
                method: 'GET',
                url: '@Url.Action("DeleteAllowance", "Allowance")',
                data: { id: id },
                success: function (resp) {
                    if (resp.success == true) {
                        toastr.success(resp.message);
                        loadData();
                    } else {
                        toastr.error(resp.message);
                    }
                },
                beforeSend: function () {
                    // $.blockUI();
                },
                complete: function () {
                    // $.unblockUI();
                }
            });
        });

        // the delete btn code end -----------

    </script>
}
