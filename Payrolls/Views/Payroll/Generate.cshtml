
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
<link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />

<div class="row">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3">
                        <label>Year</label><br />
                        <select class="form-control ddlYear">
                            <option value="0">--Select Year--</option>
                            <option value="2080">2080</option>
                            <option value="2081">2081</option>
                            <option value="2082">2082</option>
                        </select>
                    </div>

                    <div class="col-md-3">
                        <label>Month</label><br />
                        <select class="form-control ddlMonth">
                            <option value="0">--Select Month--</option>
                            <option value="1">Baishak</option>
                            <option value="2">Jestha</option>
                            <option value="3">Ashad</option>
                            <option value="4">Shrawan</option>
                            <option value="5">Bhadra</option>
                            <option value="6">Ashoj</option>
                            <option value="7">Kartik</option>
                            <option value="8">Mangshir</option>
                            <option value="9">Poush</option>
                            <option value="10">Magh</option>
                            <option value="11">Falgun</option>
                            <option value="12">Chhait</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <br />
                        <button type="button" class="btn btn-primary btnGenerate">
                            GENERATE
                        </button>
                    </div>
                </div>


            </div>
        </div>
    </div>
</div>



<div class="row mt-4">
    <div class="col-md-12">
        <div class="card">
            <div class="card-body">
                <table class="table table-hover tblSetup">
                    <thead>
                        <tr>
                            <th>SN</th>
                            <th>Id</th>
                            <th>FullName</th>
                            <th>FullNameWithId</th>
                            <th>BasicSalary</th>
                            <th>TotalAllowance</th>
                            <th>TotalDeduction</th>
                            <th>MonthlySalary</th>
                        </tr>
                    </thead>
                    <tbody class="main-data">
                    </tbody>
                </table>
            </div>
        </div>
    </div>

</div>






@section Scripts {
    <script>

        $(document).ready(function(){
            //let table = new DataTable('.my-table');

            $('.my-table').DataTable({

            });

        })



        $(document).on('click', '.btnGenerate', function () {
            console.log("Generate button clicked");
            var info = {
                yearId: $('.ddlYear').val() || 0,
                monthId: $('.ddlMonth').val() || 0
            };


            if (info.yearId == 0) {
                alert('Select Year');
            } else if (info.monthId == 0) {
                alert('Select Month')
            } else {
                $.ajax({
                    method: 'GET',
                    url: '@Url.Action("GetPayrollTable", "Payroll")?yearId=' + info.yearId + '&monthId=' + info.monthId,
                    success: function (res) {
                        console.log(res);
                        if (res.success) {
                            var htmls = '';
                            $.each(res.data, function (index, item) {
                                htmls += '<tr>';
                                htmls += '<td>' + (index + 1) + '</td>';
                                htmls += '<td>' + item.employeeId + '</td>';
                                htmls += '<td>' + item.fullname + '</td>';
                                htmls += '<td>' + item.fullnameWithId + '</td>';
                                htmls += '<td>' + item.basicSalary + '</td>';
                                htmls += '<td>' + item.totalAllowance + '</td>';
                                htmls += '<td>' + item.totalDeduction + '</td>';
                                htmls += '<td>' + item.monthlySalary + '</td>';

                                htmls += '</tr>';
                            });

                            $('.main-data').html(htmls);
                        } else {
                            toastr.error(res.message);
                        }
                    },
                    beforeSend: function () {
                        // $.blockUI();
                    },
                    complete: function () {
                        //$.unblockUI();
                    }
                });
            }
        });
    </script>

}